.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding-bottom: 40rpx;
}

/* ================= 头部 ================= */
.profile-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 48rpx 32rpx 28rpx;
}

.avatar {
    width: 112rpx;
    height: 112rpx;
    border-radius: 50%;
    flex-shrink: 0;
}

.avatar-fallback {
    background: #FBE9DD;
    color: #B9562C;
    font-size: 44rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
}

.head-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-left: 24rpx;
    min-width: 0;
}

.nickname {
    font-size: 34rpx;
    font-weight: 600;
    color: #33281F;
}

.bio {
    font-size: 24rpx;
    color: #7F6C5C;
    margin-top: 8rpx;
    line-height: 1.5;
}

.edit-link {
    font-size: 22rpx;
    color: #B9562C;
    margin-top: 10rpx;
}

.profile-bio {
    min-height: 120rpx;
}

.edit-actions {
    display: flex;
    flex-direction: row;
    margin-top: 24rpx;
}

.edit-cancel {
    flex: 1;
    width: auto;
    margin-right: 16rpx;
}

.edit-save {
    flex: 2;
    width: auto;
}

.star-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #FDF3DC;
    border-radius: 14rpx;
    padding: 12rpx 20rpx;
    flex-shrink: 0;
}

.star-num {
    font-size: 30rpx;
    font-weight: 700;
    color: #A86F0E;
}

.star-label {
    font-size: 20rpx;
    color: #A86F0E;
    margin-top: 2rpx;
}

/* ================= 统计 ================= */
.stats {
    display: flex;
    flex-direction: row;
    background: #ffffff;
    border-radius: 20rpx;
    margin: 0 24rpx 20rpx;
    padding: 28rpx 0;
}

.stat-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-num {
    font-size: 36rpx;
    font-weight: 600;
    color: #33281F;
}

.stat-label {
    font-size: 22rpx;
    color: #7F6C5C;
    margin-top: 6rpx;
}

/* ================= 星星标签 ================= */
.tag-wrap {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.star-tag {
    display: flex;
    flex-direction: row;
    align-items: center;
    font-size: 25rpx;
    color: #8C5F16;
    background: #FBF0D9;
    border-radius: 10rpx;
    padding: 10rpx 20rpx;
    margin: 0 14rpx 14rpx 0;
}

.tag-count {
    font-weight: 600;
    margin-left: 8rpx;
}

/* ================= 待回访 ================= */
.pending-card {
    border-left: 8rpx solid #A85618;
}

.pending-count {
    font-size: 24rpx;
    color: #A85618;
    background: #FBF0D9;
    border-radius: 8rpx;
    padding: 4rpx 14rpx;
}

.pending-item {
    border-top: 1rpx solid #F1E5D9;
    padding: 20rpx 0;
}

.pending-item:first-of-type {
    border-top: none;
}

.pending-title {
    display: block;
    font-size: 27rpx;
    color: #33281F;
    line-height: 1.5;
}

.pending-meta {
    display: block;
    margin-top: 8rpx;
}

/* ================= 经历档案 ================= */
.exp-form {
    background: #FBF3EA;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
}

.form-label {
    font-size: 24rpx;
    color: #7F6C5C;
    margin: 16rpx 0 12rpx;
}

.form-label:first-child {
    margin-top: 0;
}

.exp-input {
    background: #ffffff;
    border-radius: 12rpx;
    padding: 18rpx 20rpx;
    font-size: 27rpx;
    color: #33281F;
}

.picker-line {
    background: #ffffff;
    border-radius: 12rpx;
    padding: 18rpx 20rpx;
    font-size: 27rpx;
    color: #33281F;
}

.exp-form .primary-btn {
    margin-top: 28rpx;
}

.exp-item {
    border-top: 1rpx solid #F1E5D9;
    padding: 20rpx 0;
}

.exp-item:first-of-type {
    border-top: none;
}

.exp-outcome {
    margin-left: 12rpx;
}

.exp-del {
    font-size: 23rpx;
    color: #B0A093;
    margin-left: 20rpx;
}

.exp-choice {
    display: block;
    margin-top: 12rpx;
}

/* ================= Tab 与列表 ================= */
.tabs {
    display: flex;
    flex-direction: row;
    border-bottom: 1rpx solid #F1E5D9;
    margin-bottom: 8rpx;
}

.tab {
    font-size: 28rpx;
    color: #7F6C5C;
    padding: 16rpx 0;
    margin-right: 44rpx;
    border-bottom: 4rpx solid transparent;
}

.tab-active {
    color: #33281F;
    font-weight: 600;
    border-bottom-color: #B9562C;
}

.list-loading {
    padding: 40rpx 0;
    text-align: center;
}

.post-row {
    border-top: 1rpx solid #F1E5D9;
    padding: 22rpx 0;
}

.post-row:first-of-type {
    border-top: none;
}

.row-title {
    flex: 1;
    font-size: 27rpx;
    color: #33281F;
    line-height: 1.5;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    padding-right: 16rpx;
}

.row-meta {
    display: block;
    margin-top: 10rpx;
}

.bottom-space {
    height: 40rpx;
}

/* ================= 回访提醒 ================= */
.reminder-card {
    border-left: 8rpx solid #B9562C;
}

.reminder-badge {
    font-size: 24rpx;
    color: #7F6C5C;
    background: #F4EDE5;
    border-radius: 8rpx;
    padding: 4rpx 14rpx;
}

.reminder-badge-on {
    color: #457039;
    background: #E9F1E4;
}

.reminder-btn {
    margin-top: 22rpx;
    height: 72rpx;
    line-height: 72rpx;
    font-size: 28rpx;
}

.reminder-tip {
    display: block;
    margin-top: 12rpx;
    font-size: 22rpx;
    color: #A08B78;
    line-height: 1.6;
}
