.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding-bottom: 140rpx;
}

.hero {
    padding: 48rpx 32rpx 28rpx;
}
.hero-title {
    display: block;
    font-size: 56rpx;
    font-weight: 700;
    color: #185fa5;
    letter-spacing: 4rpx;
}
.hero-sub {
    display: block;
    font-size: 26rpx;
    color: #8a9099;
    margin-top: 12rpx;
}

.post-card {
    padding: 28rpx;
}
.post-title {
    display: block;
    margin: 20rpx 0 12rpx;
}
.post-summary {
    display: block;
    margin-bottom: 20rpx;
}

.status-closed {
    font-size: 22rpx;
    color: #9aa0a6;
    background: #f1f2f4;
    border-radius: 8rpx;
    padding: 4rpx 14rpx;
}

.option-preview {
    background: #f8f9fb;
    border-radius: 12rpx;
    padding: 16rpx 20rpx;
}
.mini-bar {
    display: flex;
    align-items: center;
    margin-top: 14rpx;
}
.mini-label {
    font-size: 24rpx;
    color: #4b5563;
    width: 180rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.mini-track {
    flex: 1;
    height: 14rpx;
    background: #e6e9ee;
    border-radius: 999rpx;
    margin: 0 16rpx;
    overflow: hidden;
}
.mini-fill {
    height: 100%;
    background: #378add;
    border-radius: 999rpx;
}
.mini-percent {
    font-size: 22rpx;
    color: #6b7280;
    width: 60rpx;
    text-align: right;
}

.card-footer {
    display: flex;
    align-items: center;
    margin-top: 20rpx;
}

.fab {
    position: fixed;
    right: 40rpx;
    bottom: 60rpx;
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    background: #185fa5;
    color: #ffffff;
    font-size: 56rpx;
    line-height: 96rpx;
    text-align: center;
    box-shadow: 0 8rpx 24rpx rgba(24, 95, 165, 0.3);
}
