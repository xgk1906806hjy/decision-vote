.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding-bottom: 140rpx;
}

.hero {
    padding: 48rpx 32rpx 28rpx;
    background: linear-gradient(180deg, #FCEFE3 0%, rgba(253, 248, 242, 0) 100%);
}
.hero-title {
    display: block;
    font-size: 56rpx;
    font-weight: 700;
    color: #B34E22;
    letter-spacing: 4rpx;
}
.hero-sub {
    display: block;
    font-size: 26rpx;
    color: #958070;
    margin-top: 12rpx;
}

.post-card {
    padding: 28rpx;
}
.post-title {
    display: block;
    margin: 20rpx 0 12rpx;
}
.post-summary {
    display: block;
    margin-bottom: 20rpx;
}

.status-closed {
    font-size: 22rpx;
    color: #7F6C5C;
    background: #F5EBE1;
    border-radius: 8rpx;
    padding: 4rpx 14rpx;
}

.option-preview {
    background: #FBF3EA;
    border-radius: 12rpx;
    padding: 16rpx 20rpx;
}
.mini-bar {
    display: flex;
    align-items: center;
    margin-top: 14rpx;
}
.mini-label {
    font-size: 24rpx;
    color: #5A4C42;
    width: 180rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.mini-track {
    flex: 1;
    height: 14rpx;
    background: #EFE1D3;
    border-radius: 999rpx;
    margin: 0 16rpx;
    overflow: hidden;
}
.mini-fill {
    height: 100%;
    background: linear-gradient(90deg, #D9824E 0%, #B9562C 100%);
    border-radius: 999rpx;
}
.mini-percent {
    font-size: 22rpx;
    color: #7F6C5C;
    width: 60rpx;
    text-align: right;
}

.card-footer {
    display: flex;
    align-items: center;
    margin-top: 20rpx;
}

.fab {
    position: fixed;
    right: 40rpx;
    bottom: 60rpx;
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #C25826 0%, #B34E22 100%);
    color: #ffffff;
    font-size: 56rpx;
    line-height: 96rpx;
    text-align: center;
    box-shadow: 0 10rpx 28rpx rgba(179, 78, 34, 0.35);
}
