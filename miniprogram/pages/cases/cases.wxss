.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding-bottom: 40rpx;
}

.head {
    padding: 40rpx 32rpx 20rpx;
}

.head-title {
    display: block;
    font-size: 44rpx;
    font-weight: 700;
    color: #33281F;
}

.head-sub {
    display: block;
    font-size: 25rpx;
    color: #958070;
    margin-top: 10rpx;
    line-height: 1.6;
}

/* 搜索 */
.search-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    background: #ffffff;
    border-radius: 999rpx;
    padding: 8rpx 28rpx;
    margin-top: 24rpx;
}

.search-input {
    flex: 1;
    font-size: 27rpx;
    color: #33281F;
    padding: 12rpx 0;
}

.search-btn,
.search-clear {
    font-size: 26rpx;
    color: #B9562C;
    padding-left: 20rpx;
}

.search-clear {
    color: #7F6C5C;
}

/* 聚合统计 */
.stats-card {
    background: #FFFFFF;
    border-radius: 20rpx;
    padding: 24rpx 28rpx;
    margin: 12rpx 24rpx 20rpx;
    box-shadow: 0 2rpx 12rpx rgba(120, 72, 40, 0.06);
}

.stats-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.stats-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #33281F;
}

.stats-bar {
    display: flex;
    flex-direction: row;
    height: 14rpx;
    border-radius: 999rpx;
    overflow: hidden;
    background: #EFE1D3;
    margin-top: 18rpx;
}

.stats-seg {
    height: 100%;
}

.stats-worth {
    background: #457039;
}

.stats-regret {
    background: #B0392B;
}

.stats-watching {
    background: #C99A2E;
}

.stats-legend {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 14rpx;
}

.stats-legend-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    font-size: 23rpx;
    color: #5A4C42;
    margin: 0 20rpx 8rpx 0;
}

.stats-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    margin-right: 8rpx;
}

.dot-worth {
    background: #457039;
}

.dot-regret {
    background: #B0392B;
}

.dot-watching {
    background: #C99A2E;
}

.stats-note {
    display: block;
    font-size: 22rpx;
    color: #B0A093;
    margin-top: 4rpx;
    line-height: 1.5;
}

.stats-scenes {
    border-top: 1rpx solid #F1E5D9;
    margin-top: 16rpx;
    padding-top: 16rpx;
}

.stats-scenes-title {
    display: block;
    font-size: 24rpx;
    color: #7F6C5C;
    margin-bottom: 10rpx;
}

.stats-scene-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.stats-scene {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-width: 120rpx;
    font-size: 23rpx;
    color: #33281F;
    background: #FBF3EA;
    border-radius: 10rpx;
    padding: 8rpx 14rpx;
    margin: 0 12rpx 10rpx 0;
}

.stats-scene .muted {
    margin-left: 8rpx;
}

/* 案例卡片 */
.case-card {
    background: #ffffff;
    border-radius: 20rpx;
    padding: 28rpx;
    margin: 20rpx 24rpx;
    box-shadow: 0 2rpx 12rpx rgba(120, 72, 40, 0.06);
}

.case-title {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    line-height: 1.5;
    color: #33281F;
    margin: 16rpx 0 12rpx;
}

.case-content {
    font-size: 26rpx;
    line-height: 1.7;
    color: #7F6C5C;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.case-result {
    background: #F6FAF2;
    border-radius: 14rpx;
    padding: 20rpx;
    margin-top: 20rpx;
}

.result-row {
    display: flex;
    flex-direction: row;
    margin-top: 12rpx;
}

.result-row:first-child {
    margin-top: 0;
}

.result-label {
    font-size: 23rpx;
    color: #457039;
    width: 130rpx;
    flex-shrink: 0;
}

.result-value {
    flex: 1;
    font-size: 26rpx;
    color: #33281F;
    font-weight: 500;
}

.result-note {
    flex: 1;
    font-size: 25rpx;
    color: #5A4C42;
    line-height: 1.6;
}

.case-foot {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 20rpx;
}
