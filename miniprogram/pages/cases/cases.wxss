.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding-bottom: 40rpx;
}

.head {
    padding: 40rpx 32rpx 20rpx;
}

.head-title {
    display: block;
    font-size: 44rpx;
    font-weight: 700;
    color: #1f2329;
}

.head-sub {
    display: block;
    font-size: 25rpx;
    color: #8a9099;
    margin-top: 10rpx;
    line-height: 1.6;
}

/* 搜索 */
.search-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    background: #ffffff;
    border-radius: 999rpx;
    padding: 8rpx 28rpx;
    margin-top: 24rpx;
}

.search-input {
    flex: 1;
    font-size: 27rpx;
    color: #1f2329;
    padding: 12rpx 0;
}

.search-btn,
.search-clear {
    font-size: 26rpx;
    color: #185fa5;
    padding-left: 20rpx;
}

.search-clear {
    color: #9aa0a6;
}

/* 案例卡片 */
.case-card {
    background: #ffffff;
    border-radius: 20rpx;
    padding: 28rpx;
    margin: 20rpx 24rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.case-title {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    line-height: 1.5;
    color: #1f2329;
    margin: 16rpx 0 12rpx;
}

.case-content {
    font-size: 26rpx;
    line-height: 1.7;
    color: #6b7280;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.case-result {
    background: #f7fbf9;
    border-radius: 14rpx;
    padding: 20rpx;
    margin-top: 20rpx;
}

.result-row {
    display: flex;
    flex-direction: row;
    margin-top: 12rpx;
}

.result-row:first-child {
    margin-top: 0;
}

.result-label {
    font-size: 23rpx;
    color: #0f6e56;
    width: 130rpx;
    flex-shrink: 0;
}

.result-value {
    flex: 1;
    font-size: 26rpx;
    color: #1f2329;
    font-weight: 500;
}

.result-note {
    flex: 1;
    font-size: 25rpx;
    color: #4b5563;
    line-height: 1.6;
}

.case-foot {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 20rpx;
}
