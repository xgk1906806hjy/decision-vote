/* ================= 决策正文 ================= */
.post-title {
    display: block;
    font-size: 36rpx;
    font-weight: 600;
    line-height: 1.5;
    color: #33281F;
    margin: 16rpx 0 12rpx;
}

.post-content {
    display: block;
    margin-top: 8rpx;
}

.closed-badge {
    font-size: 22rpx;
    color: #7F6C5C;
    background: #F1E5D9;
    border-radius: 8rpx;
    padding: 4rpx 14rpx;
    margin-left: 12rpx;
}

/* ================= 投票 ================= */
.blind-badge {
    font-size: 22rpx;
    color: #8C5F16;
    background: #FBF0D9;
    border-radius: 8rpx;
    padding: 4rpx 14rpx;
}

.blind-hint {
    font-size: 24rpx;
    color: #8C5F16;
    background: #FEF6EC;
    border-radius: 12rpx;
    padding: 16rpx 20rpx;
    margin: 16rpx 0 8rpx;
}

.option-item {
    border: 2rpx solid #F1E5D9;
    border-radius: 14rpx;
    padding: 22rpx 20rpx;
    margin-top: 16rpx;
    transition: border-color 0.15s, background 0.15s;
}

.option-item.selected {
    border-color: #B9562C;
    background: #FDF3EA;
    box-shadow: 0 4rpx 16rpx rgba(185, 86, 44, 0.1);
}

.option-label {
    font-size: 28rpx;
    color: #33281F;
    flex: 1;
    padding-right: 16rpx;
    line-height: 1.5;
}

.option-percent {
    font-size: 26rpx;
    font-weight: 600;
    color: #B9562C;
}

.option-check {
    font-size: 24rpx;
    color: #B9562C;
}

.chosen-flag {
    font-size: 22rpx;
    color: #457039;
    background: #EAF2E3;
    border-radius: 8rpx;
    padding: 4rpx 12rpx;
    margin-left: 12rpx;
}

.bar-track {
    height: 10rpx;
    background: #F1E5D9;
    border-radius: 6rpx;
    margin-top: 16rpx;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #D9824E 0%, #B9562C 100%);
    border-radius: 6rpx;
}

.bar-anim {
    animation: grow 0.5s ease-out;
}

@keyframes grow {
    from { width: 0 !important; }
}

.vote-btn {
    margin-top: 28rpx;
}

.reveal-tip {
    margin-top: 24rpx;
    font-size: 24rpx;
    color: #457039;
    background: #EAF2E3;
    border-radius: 12rpx;
    padding: 16rpx 20rpx;
    text-align: center;
}

/* ================= 结局 ================= */
.outcome-card {
    border-left: 8rpx solid #457039;
}

.outcome-note {
    display: block;
    margin-top: 16rpx;
    background: #F6FAF2;
    border-radius: 12rpx;
    padding: 18rpx 20rpx;
}

/* ================= 方案 ================= */

.solution-item {
    border-top: 1rpx solid #F1E5D9;
    padding: 24rpx 0 8rpx;
}

.solution-item:first-of-type {
    border-top: none;
}

.solution-adopted {
    background: #F6FAF2;
    border-radius: 12rpx;
    padding: 20rpx;
    margin-top: 16rpx;
    border-top: none;
}

.sol-head {
    flex-wrap: wrap;
}

.sol-author {
    font-size: 26rpx;
    font-weight: 500;
    color: #33281F;
}

.star-badge {
    font-size: 22rpx;
    color: #A86F0E;
    background: #FDF3DC;
    border-radius: 8rpx;
    padding: 4rpx 12rpx;
    margin-left: 10rpx;
}

.sol-tag {
    margin-left: 10rpx;
}

.adopted-badge {
    font-size: 22rpx;
    color: #457039;
    background: #EAF2E3;
    border-radius: 8rpx;
    padding: 4rpx 14rpx;
}

.sol-content {
    display: block;
    margin-top: 14rpx;
}

.sol-actions {
    margin-top: 18rpx;
}

.like-btn {
    font-size: 24rpx;
    color: #7F6C5C;
    padding: 6rpx 4rpx;
}

.like-btn.liked {
    color: #B0392B;
}

.adopt-btn {
    font-size: 24rpx;
    color: #B9562C;
    border: 2rpx solid #B9562C;
    border-radius: 10rpx;
    padding: 8rpx 22rpx;
}

/* ================= 建议 ================= */
.tag-picker {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 12rpx;
}

.tag-picker-label {
    font-size: 24rpx;
    color: #7F6C5C;
    margin-right: 14rpx;
}

.tag-chip {
    font-size: 24rpx;
    color: #7F6C5C;
    background: #ffffff;
    border: 2rpx solid #F1E5D9;
    border-radius: 24rpx;
    padding: 8rpx 24rpx;
    margin-right: 12rpx;
    margin-top: 8rpx;
}

.chip-worth {
    color: #457039;
    border-color: #457039;
    background: #EAF2E3;
}

.chip-regret {
    color: #B0392B;
    border-color: #B0392B;
    background: #FBE8E3;
}

.chip-watching {
    color: #8C5F16;
    border-color: #8C5F16;
    background: #FBF0D9;
}

.comment-item {
    border-top: 1rpx solid #F1E5D9;
    padding: 24rpx 0;
}

.comment-item:first-of-type {
    border-top: none;
}

.comment-user {
    font-size: 26rpx;
    font-weight: 500;
    color: #33281F;
}

.comment-tag {
    margin-left: 10rpx;
}

.comment-content {
    display: block;
    margin-top: 12rpx;
}

.comment-support {
    display: block;
    margin-top: 10rpx;
}

/* ================= 回访 ================= */
.follow-label {
    font-size: 24rpx;
    color: #7F6C5C;
    margin: 24rpx 0 12rpx;
}

.follow-options {
    flex-wrap: wrap;
}

.follow-option {
    font-size: 26rpx;
    color: #5A4C42;
    background: #FBF3EA;
    border: 2rpx solid #F1E5D9;
    border-radius: 12rpx;
    padding: 14rpx 24rpx;
    margin: 0 12rpx 12rpx 0;
}

.follow-selected {
    color: #B9562C;
    border-color: #B9562C;
    background: #FDF3EA;
}

.follow-selected-worth {
    color: #457039;
    border-color: #457039;
    background: #EAF2E3;
}

.follow-selected-regret {
    color: #B0392B;
    border-color: #B0392B;
    background: #FBE8E3;
}

.follow-selected-watching {
    color: #8C5F16;
    border-color: #8C5F16;
    background: #FBF0D9;
}

.follow-note {
    background: #FBF3EA;
    border-radius: 16rpx;
    padding: 20rpx;
    margin-bottom: 24rpx;
}

.bottom-space {
    height: 60rpx;
}
